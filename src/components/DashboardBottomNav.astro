---
import { getDashboardNavigation } from "@/lib/dashboard-navigation";

const { currentPath, role } = Astro.props;
const navigation = getDashboardNavigation(role, currentPath);
---

<nav class="md:hidden fixed bottom-0 inset-x-0 h-16 border-t bg-background z-50" aria-label={navigation.ariaLabel}>
  <div class="flex h-full items-stretch">
    {role === "super_admin" && (
      <a
        href={navigation.items[0]?.href}
        aria-current={navigation.items[0]?.isCurrent ? "page" : undefined}
        class={`flex flex-1 flex-col items-center justify-center gap-1 text-xs transition-colors ${
          navigation.items[0]?.isCurrent ? "text-primary" : "text-muted-foreground hover:text-foreground"
        }`}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 2l7 4v6c0 5-3.5 9.74-7 10-3.5-.26-7-5-7-10V6l7-4z"></path>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        <span>{navigation.items[0]?.mobileLabel}</span>
      </a>
    )}

    {role === "shelter" && (
      <>
        <a
          href={navigation.items[0]?.href}
          aria-current={navigation.items[0]?.isCurrent ? "page" : undefined}
          class={`flex flex-1 flex-col items-center justify-center gap-1 text-xs transition-colors ${
            navigation.items[0]?.isCurrent ? "text-primary" : "text-muted-foreground hover:text-foreground"
          }`}
        >
          <!-- ClipboardList icon (Lucide inline SVG) -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect>
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
            <path d="M12 11h4"></path>
            <path d="M12 16h4"></path>
            <path d="M8 11h.01"></path>
            <path d="M8 16h.01"></path>
          </svg>
          <span>{navigation.items[0]?.mobileLabel}</span>
        </a>

        <a
          href={navigation.items[1]?.href}
          aria-current={navigation.items[1]?.isCurrent ? "page" : undefined}
          class={`flex flex-1 flex-col items-center justify-center gap-1 text-xs transition-colors ${
            navigation.items[1]?.isCurrent ? "text-primary" : "text-muted-foreground hover:text-foreground"
          }`}
        >
          <!-- User icon (Lucide inline SVG) -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span>{navigation.items[1]?.mobileLabel}</span>
        </a>
      </>
    )}
  </div>
</nav>
