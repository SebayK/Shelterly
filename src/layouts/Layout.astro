---
import "../styles/global.css";
import Navbar from "@/components/Navbar.astro";
import { logError } from "@/lib/errors";
import { getOptionalUser } from "@/lib/supabase-auth";
import type { NavbarUser } from "@/types";

interface Props {
  title?: string;
  withLeaflet?: boolean;
}

const { title = "Shelterly", withLeaflet = false } = Astro.props;

let navbarUser: NavbarUser | null = null;

try {
  const { user, error } = await getOptionalUser(Astro.locals.supabase);

  if (error) {
    logError("[Layout] Failed to fetch user session", error);
  }

  if (user) {
    const { data: profile } = await Astro.locals.supabase
      .from("profiles")
      .select("role, name")
      .eq("id", user.id)
      .single();

    if (profile) {
      navbarUser = { name: profile.name, role: profile.role };
    }
  }
} catch (err) {
  logError("[Layout] Failed to fetch user session", err);
}
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    {
      withLeaflet && (
        <>
          <link
            rel="stylesheet"
            href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
            integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
            crossorigin="anonymous"
          />
          <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
          <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
        </>
      )
    }
    <title>{title}</title>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-md focus:bg-background focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:shadow-md focus:outline-none focus:ring-2 focus:ring-ring"
    >
      Przejdź do treści
    </a>
    <Navbar user={navbarUser} />
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
