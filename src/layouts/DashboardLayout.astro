---
import DashboardShell from "@/layouts/DashboardShell.astro";
import { logError, UnauthorizedError } from "@/lib/errors";
import { ProfileService } from "@/lib/services/profile.service";
import type { ProfileMeDTO } from "@/types";

interface Props {
  title?: string;
}

const { title = "Dashboard — Shelterly" } = Astro.props;

const currentPath = Astro.url.pathname;

// Auth guard — redirect to login if no valid session
const {
  data: { user },
  error: authError,
} = await Astro.locals.supabase.auth.getUser();

if (authError || !user) {
  return Astro.redirect(`/auth/login?return=${currentPath}`);
}

let profile: ProfileMeDTO;

try {
  const profileService = new ProfileService(Astro.locals.supabase);
  profile = await profileService.getAuthenticatedProfile(user.id);
} catch (err) {
  logError("[DashboardLayout] Failed to fetch profile", err);
  if (err instanceof UnauthorizedError) {
    return Astro.redirect(`/auth/login?return=${currentPath}`);
  }

  throw err;
}
---

<DashboardShell title={title} profile={profile} currentPath={currentPath}>
  <slot />
</DashboardShell>
