---
import Layout from "../../layouts/Layout.astro";
import { ProfileService } from "../../lib/services/profile.service";
import { NeedsService } from "../../lib/services/needs.service";
import type { ProfileDetailDTO, NeedListItemDTO } from "../../types";
import Breadcrumb from "../../components/shelter-detail/Breadcrumb.astro";
import ShelterHeader from "../../components/shelter-detail/ShelterHeader.astro";
import NeedsSummarySection from "../../components/shelter-detail/NeedsSummarySection.astro";
import { ShelterDetailView } from "../../components/shelter-detail/ShelterDetailView";

export const prerender = false;

const rewriteToNotFound = () => {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";

  return Astro.rewrite("/404");
};

// Get and validate the shelter ID from URL params
const { id } = Astro.params;

// Validate UUID format
const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

if (!id || !uuidRegex.test(id)) {
  return rewriteToNotFound();
}

let shelter: ProfileDetailDTO;
let needs: NeedListItemDTO[] = [];

try {
  const supabase = Astro.locals.supabase;
  if (!supabase) {
    // eslint-disable-next-line no-console
    console.error("Supabase client not available in Astro.locals");
    return rewriteToNotFound();
  }

  const profileService = new ProfileService(supabase);
  shelter = await profileService.getProfileById(id);

  const needsService = new NeedsService(supabase);
  const needsResponseData = await needsService.getNeeds({
    shelter_id: id,
    limit: 100,
    offset: 0,
  });

  needs = needsResponseData.data;
} catch (error) {
  // eslint-disable-next-line no-console
  console.error("Error fetching shelter details:", error);
  return rewriteToNotFound();
}

// Generate page metadata
const pageTitle = `${shelter.name} - Shelterly`;
---

<Layout title={pageTitle}>
  <main class="min-h-screen bg-gray-50">
    <div class="container mx-auto px-4 py-8 max-w-7xl">
      <!-- Breadcrumb Navigation -->
      <Breadcrumb shelterName={shelter.name} />

      <!-- Shelter Header -->
      <ShelterHeader
        name={shelter.name}
        address={shelter.address}
        city={shelter.city}
        phoneNumber={shelter.phone_number}
        websiteUrl={shelter.website_url}
      />

      <!-- Needs Summary Section -->
      <NeedsSummarySection summary={shelter.needs_summary} />

      <!-- Interactive Shelter Detail View with Needs List -->
      <ShelterDetailView client:load needs={needs} />
    </div>
  </main>
</Layout>
