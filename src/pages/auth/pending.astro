---
import Layout from "@/layouts/Layout.astro";
import { logError } from "@/lib/errors";
import type { ShelterStatus, UserRole } from "@/types";

export const prerender = false;

type PendingViewMode = "anonymous" | "pending" | "rejected";

const viewState: {
  mode: PendingViewMode;
  title: string;
  description: string;
  helperText: string;
  rejectionReason: string | null;
  primaryHref: string;
  primaryLabel: string;
} = {
  mode: "anonymous",
  title: "Konto oczekuje na weryfikację",
  description:
    "Twoje zgłoszenie zostało przyjęte. Administrator zweryfikuje dostarczone dane i dokument potwierdzający działalność schroniska. Proces weryfikacji może potrwać do 48 godzin.",
  helperText:
    "Po pozytywnej weryfikacji otrzymasz dostęp do panelu zarządzania schroniskiem. W razie pytań skontaktuj się z nami.",
  rejectionReason: null,
  primaryHref: "/",
  primaryLabel: "Wróć na stronę główną",
};

// Server-side guard: redirect users who no longer need this page
try {
  const {
    data: { user },
    error: authError,
  } = await Astro.locals.supabase.auth.getUser();

  if (authError) {
    logError("[pending.astro] Failed to get user session", authError);
  }

  if (user) {
    const { data: profile, error: profileError } = await Astro.locals.supabase
      .from("profiles")
      .select("status, role, rejection_reason")
      .eq("id", user.id)
      .single<{ status: ShelterStatus; role: UserRole; rejection_reason: string | null }>();

    if (profileError) {
      logError("[pending.astro] Failed to fetch profile", profileError);
    }

    if (profile) {
      if (profile.role === "super_admin") {
        return Astro.redirect("/admin");
      }
      if (profile.status === "verified") {
        return Astro.redirect("/dashboard");
      }

      if (profile.status === "pending") {
        viewState.mode = "pending";
        viewState.title = "Uzupełnij dokument do weryfikacji";
        viewState.description =
          "Twoje konto jest już aktywne w ograniczonym zakresie. Uzupełnij dane profilu i dołącz dokument weryfikacyjny, aby administrator mógł zakończyć proces weryfikacji.";
        viewState.helperText =
          "Do czasu zatwierdzenia możesz edytować profil i przesłać dokument, ale zarządzanie potrzebami pozostaje zablokowane.";
        viewState.primaryHref = "/dashboard/profile";
        viewState.primaryLabel = "Przejdź do profilu schroniska";
      }

      if (profile.status === "rejected") {
        viewState.mode = "rejected";
        viewState.title = "Popraw zgłoszenie i wyślij dokument ponownie";
        viewState.description = profile.rejection_reason?.trim()
          ? `Administrator odrzucił wcześniejsze zgłoszenie. Powód: ${profile.rejection_reason.trim()}`
          : "Administrator odrzucił wcześniejsze zgłoszenie. Zaktualizuj dane schroniska i prześlij poprawiony dokument weryfikacyjny, aby ponownie trafił do kolejki weryfikacyjnej.";
        viewState.helperText =
          "Konto działa w trybie ograniczonym: możesz edytować profil i wysłać nowy dokument, ale zarządzanie potrzebami pozostaje zablokowane do czasu pozytywnej decyzji.";
        viewState.rejectionReason = profile.rejection_reason?.trim() || null;
        viewState.primaryHref = "/dashboard/profile";
        viewState.primaryLabel = "Popraw profil i dokument";
      }
    }
  }
} catch (err) {
  logError("[pending.astro] Unexpected error during session check", err);
}
---

<Layout title={`${viewState.title} — Shelterly`}>
  <section
    class="flex min-h-[calc(100vh-3.5rem)] flex-col items-center justify-center px-4 py-12 text-center"
    aria-labelledby="pending-heading"
  >
    <div class="flex max-w-md flex-col items-center gap-6">
      <!-- Clock icon -->
      <div
        class="flex h-20 w-20 items-center justify-center rounded-full bg-amber-100 text-amber-600"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="40"
          height="40"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>

      <!-- Heading -->
      <h1 id="pending-heading" class="text-2xl font-semibold tracking-tight text-foreground">
        {viewState.title}
      </h1>

      <!-- Description -->
      <p class="text-base leading-relaxed text-muted-foreground">{viewState.description}</p>

      <p class="text-sm text-muted-foreground">{viewState.helperText}</p>

      {viewState.rejectionReason && (
        <div class="w-full rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-left text-sm text-red-900">
          <p class="font-medium">Powód odrzucenia</p>
          <p class="mt-1">{viewState.rejectionReason}</p>
        </div>
      )}

      <div class="flex flex-col items-center gap-3 sm:flex-row">
        <a
          href={viewState.primaryHref}
          class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          {viewState.primaryLabel}
        </a>
        {viewState.primaryHref !== "/" && (
          <a
            href="/"
            class="inline-flex h-10 items-center justify-center rounded-md border border-input bg-background px-6 text-sm font-medium text-foreground shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
          >
            Wróć na stronę główną
          </a>
        )}
      </div>

      {viewState.mode !== "anonymous" && (
        <p class="max-w-md text-xs text-muted-foreground">
          Jeśli dokument został już dodany, poczekaj na ponowne rozpatrzenie zgłoszenia przez administratora.
        </p>
      )}
    </div>
  </section>
</Layout>
