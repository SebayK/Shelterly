---
import Layout from "@/layouts/Layout.astro";
import LoginForm from "@/components/auth/LoginForm";
import { logError } from "@/lib/errors";

export const prerender = false;

/**
 * Guard against open-redirect attacks: only allow relative paths that start
 * with "/" and do not start with "//" (which browsers treat as protocol-relative).
 */
function sanitizeReturnUrl(raw: string | null): string {
  if (!raw) return "/dashboard";
  const trimmed = raw.trim();
  if (trimmed.startsWith("/") && !trimmed.startsWith("//")) return trimmed;
  return "/dashboard";
}

const returnUrl = sanitizeReturnUrl(Astro.url.searchParams.get("return"));

// Server-side session guard: if a valid Supabase session exists,
// redirect immediately without rendering the form.
// With @supabase/ssr, the auth state is automatically read from cookies.
const { data, error } = await Astro.locals.supabase.auth.getUser();

if (error) {
  logError("[login.astro] Failed to validate Supabase user", error);
}

if (data?.user) {
  return Astro.redirect(returnUrl);
}
---

<Layout title="Zaloguj się — Shelterly">
  <main class="flex min-h-screen items-center justify-center bg-background px-4">
    <LoginForm returnUrl={returnUrl} client:load />
  </main>
</Layout>
