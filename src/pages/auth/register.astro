---
import Layout from "@/layouts/Layout.astro";
import RegisterForm from "@/components/auth/RegisterForm";
import { logError } from "@/lib/errors";
import { getOptionalUser } from "@/lib/supabase-auth";

export const prerender = false;

// Server-side session guard: if a valid Supabase session exists,
// redirect immediately without rendering the form.
const { user, error } = await getOptionalUser(Astro.locals.supabase);

if (error) {
  logError("[register.astro] Failed to validate Supabase user", error);
}

if (user) {
  return Astro.redirect("/dashboard");
}
---

<Layout title="Zarejestruj się — Shelterly">
  <main class="flex min-h-screen items-center justify-center bg-background px-4 py-8 sm:px-8 lg:px-12">
    <RegisterForm client:load />
  </main>
</Layout>
