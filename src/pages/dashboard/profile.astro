---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { isSuspendedShelterSession } from "@/lib/auth-access";
import { logError, UnauthorizedError } from "@/lib/errors";
import { ProfileService } from "@/lib/services/profile.service";
import ProfileForm from "@/components/profile/ProfileForm";
import type { ProfileMeDTO } from "@/types";

export const prerender = false;

const currentPath = Astro.url.pathname;

// This page loads its own authenticated profile data and renders the shared dashboard shell.
const {
  data: { user },
  error: authError,
} = await Astro.locals.supabase.auth.getUser();

if (authError || !user) {
  return Astro.redirect(`/auth/login?return=${currentPath}`);
}

let profile: ProfileMeDTO;
try {
  const profileService = new ProfileService(Astro.locals.supabase);
  profile = await profileService.getAuthenticatedProfile(user.id);
} catch (err) {
  logError("[profile.astro] Failed to fetch profile", err);
  if (err instanceof UnauthorizedError) {
    return Astro.redirect(`/auth/login?return=${currentPath}`);
  }

  throw err;
}

if (isSuspendedShelterSession(profile.role, profile.status)) {
  await Astro.locals.supabase.auth.signOut();
  return Astro.redirect("/auth/login");
}
---

<DashboardLayout title="Edycja profilu — Shelterly" profile={profile} currentPath={currentPath}>
  <ProfileForm profile={profile} client:load />
</DashboardLayout>
