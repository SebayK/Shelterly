{
  "eslint.enable": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "astro"],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "cSpell.words": ["Shelterly", "supabase"],
  "chat.tools.terminal.autoApprove": {
    "npx eslint": true,
    "git commit": true,
    "npx vitest": true,
    "npx shadcn@latest": true,
    "npm install": true,
    "git add": true,
    "npx tsc": true,
    "supabase": true,
    "npx prettier": true,
    "npm exec": true
  }
}
