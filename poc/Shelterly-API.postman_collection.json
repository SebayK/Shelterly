{
  "info": {
    "name": "Shelterly API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "supabase_url",
      "value": "http://127.0.0.1:54321"
    },
    {
      "key": "anon_key",
      "value": "SUPABASE_LOCAL_ANON_KEY"
    },
    {
      "key": "access_token",
      "value": "WKLEJ_TOKEN_TUTAJ"
    },
    {
      "key": "need_id",
      "value": ""
    },
    {
      "key": "timestamp",
      "value": ""
    },
    {
      "key": "new_user_id",
      "value": ""
    },
    {
      "key": "profile_id",
      "value": ""
    },
    {
      "key": "service_role_key",
      "value": "SUPABASE_LOCAL_SERVICE_ROLE_KEY"
    },
    {
      "key": "admin_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('access_token', json.access_token);",
                  "    console.log('✅ Token zapisany automatycznie');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anon_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"schronisko.warszawa@example.com\",\n  \"password\": \"SecurePassword123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{supabase_url}}/auth/v1/token?grant_type=password"
          }
        },
        {
          "name": "Signup (rejestracja)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.collectionVariables.set('timestamp', Math.floor(Date.now() / 1000));"],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "    const json = pm.response.json();",
                  "    if (json.access_token) {",
                  "        pm.collectionVariables.set('access_token', json.access_token);",
                  "        console.log('✅ Token zapisany automatycznie');",
                  "    }",
                  "    const uid = json.user?.id || json.user_id;",
                  "    if (uid) {",
                  "        pm.collectionVariables.set('new_user_id', uid);",
                  "        console.log('✅ User ID zapisany:', uid);",
                  "    }",
                  "    pm.test('Signup returned 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "} catch (e) {",
                  "    console.error('Signup error:', e);",
                  "    pm.test('Response is JSON', () => false);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anon_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"signup-test+{{timestamp}}@example.com\",\n  \"password\": \"TestPass123!\",\n  \"data\": {\n    \"role\": \"shelter\",\n    \"name\": \"Test Shelter\",\n    \"city\": \"Kraków\",\n    \"address\": \"ul. Testowa 1\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{supabase_url}}/auth/v1/signup"
          }
        }
      ]
    },
    {
      "name": "2. Admin (Verification)",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('admin_token', json.access_token);",
                  "    console.log('✅ Admin token zapisany');",
                  "}",
                  "pm.test('Status 200', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Has access_token', () => pm.expect(json.access_token).to.exist);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{anon_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@shelterly.dev\",\n  \"password\": \"Admin123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{supabase_url}}/auth/v1/token?grant_type=password"
          }
        },
        {
          "name": "PATCH Verify Shelter (verify new user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 401 or 404', () => pm.expect([200,401,404]).to.include(pm.response.code));",
                  "if(pm.response.code === 200){ const json = pm.response.json(); pm.test('Has id', () => pm.expect(json.id).to.exist); pm.test('Status is verified', () => pm.expect(json.status).to.equal('verified')); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"verified\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/shelters/{{new_user_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "shelters", "{{new_user_id}}", "status"]
            }
          }
        }
      ]
    },
